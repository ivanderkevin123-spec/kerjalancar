# Copy to .env (git-ignored). Values below match docker-compose.yml and are for local development only.
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
LOG_LEVEL=debug
# true only behind a proxy that sets X-Forwarded-For (e.g. the hosting platform's edge); never on a bare port
TRUSTED_PROXY=false
# Self-registration at /daftar: on outside production; set REGISTRATION_OPEN=true to allow it in production.
# REGISTRATION_CODE, when set, is required on the registration form (share it with pilots).
REGISTRATION_OPEN=true
REGISTRATION_CODE=
DATABASE_URL=postgres://kerjalancar:kerjalancar@localhost:5432/kerjalancar?sslmode=disable
TEST_DATABASE_URL=postgres://kerjalancar:kerjalancar@localhost:5432/kerjalancar_test?sslmode=disable
